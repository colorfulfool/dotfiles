#!/bin/bash
# Reset I2C-HID touchpads after a system sleep.
#
# On the IdeaPad 3 17IML05 (MSFT0001:01) the touchpad stays bound to
# i2c_hid_acpi but stops reporting input after resuming from hibernation.
# Unbinding and rebinding the device reinitializes it, the same thing a
# physical replug / lid-close S3 cycle used to do.
set -u

[ "${1:-}" = "post" ] || exit 0
# S3 resume reinitializes the device on its own; only hibernation leaves it
# dead. suspend-then-hibernate triggers this separately once it hibernates.
case "${SYSTEMD_SLEEP_ACTION:-${2:-}}" in
  hibernate | hybrid-sleep) ;;
  *) exit 0 ;;
esac

DRIVER=/sys/bus/i2c/drivers/i2c_hid_acpi

# Give the EC and the DesignWare I2C controller a moment to settle.
sleep 1

devices=()
for path in "$DRIVER"/i2c-*; do
  [[ -e "$path" ]] || continue
  devices+=("${path##*/}")
done

for dev in "${devices[@]}"; do
  printf '%s' "$dev" 2>/dev/null >"$DRIVER/unbind" || true
done

sleep 1

status=0
for dev in "${devices[@]}"; do
  for _ in 1 2 3 4 5; do
    if printf '%s' "$dev" 2>/dev/null >"$DRIVER/bind"; then
      logger -t i2c-hid-touchpad-reset "rebound $dev after resume"
      continue 2
    fi
    sleep 1
  done
  logger -t i2c-hid-touchpad-reset "failed to rebind $dev after resume"
  status=1
done

exit "$status"
